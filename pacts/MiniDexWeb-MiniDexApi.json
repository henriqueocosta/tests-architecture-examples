{
  "consumer": {
    "name": "MiniDexWeb"
  },
  "interactions": [
    {
      "description": "a request for a TKA to TKB quote",
      "pending": false,
      "providerStates": [
        {
          "name": "the price provider is available"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/quotes",
        "query": {
          "amount": [
            "100"
          ],
          "from": [
            "TKA"
          ],
          "to": [
            "TKB"
          ]
        }
      },
      "response": {
        "body": {
          "content": {
            "amountIn": "100.0",
            "amountOut": "199.4",
            "expiresAt": "2026-01-01T12:00:15.000Z",
            "fee": "0.6",
            "feeBps": 30,
            "from": "TKA",
            "price": 2,
            "quoteId": "5f0c3b8e-8a3a-4f7e-9d0f-2a6f1f1c9b10",
            "to": "TKB"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.amountIn": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.amountOut": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.expiresAt": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^\\d{4}-[01]\\d-[0-3]\\dT[0-2]\\d:[0-5]\\d:[0-5]\\d\\.\\d+([+-][0-2]\\d(:?[0-5]\\d)?|Z)$"
                }
              ]
            },
            "$.fee": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.feeBps": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.price": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.quoteId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
    {
      "description": "a request for a quote while the price provider is down",
      "pending": false,
      "providerStates": [
        {
          "name": "the price provider is down"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/quotes",
        "query": {
          "amount": [
            "100"
          ],
          "from": [
            "TKA"
          ],
          "to": [
            "TKB"
          ]
        }
      },
      "response": {
        "body": {
          "content": {
            "error": {
              "code": "PRICE_PROVIDER_UNAVAILABLE",
              "message": "Price provider failure"
            }
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.error.message": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 503
      },
      "type": "Synchronous/HTTP"
    },
    {
