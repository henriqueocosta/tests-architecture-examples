    {
      "description": "a request for the swap history",
      "pending": false,
      "providerStates": [
        {
          "name": "a swap exists in the history"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/swaps"
      },
      "response": {
        "body": {
          "content": {
            "swaps": [
              {
                "amountIn": "100.0",
                "createdAt": "2026-01-01T12:00:00.000Z",
                "from": "TKA",
                "status": "confirmed",
                "swapId": "0b6b2a9e-3d4e-4c55-8f8e-6a1d2c3b4a59",
                "to": "TKB"
              }
            ]
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.swaps": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.swaps[*].amountIn": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.swaps[*].createdAt": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^\\d{4}-[01]\\d-[0-3]\\dT[0-2]\\d:[0-5]\\d:[0-5]\\d\\.\\d+([+-][0-2]\\d(:?[0-5]\\d)?|Z)$"
                }
              ]
            },
            "$.swaps[*].from": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.swaps[*].status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.swaps[*].swapId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.swaps[*].to": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    },
