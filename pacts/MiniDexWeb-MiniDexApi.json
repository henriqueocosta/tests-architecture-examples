    {
      "description": "a request for the account balances",
      "pending": false,
      "providerStates": [
        {
          "name": "the trading account has balances"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/balances"
      },
      "response": {
        "body": {
          "content": {
            "account": "0x70997970C51812dc3A010C7d01b50e0d17dc79C8",
            "balances": {
              "TKA": "1000000.0",
              "TKB": "1000000.0"
            }
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.account": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "^0x[0-9a-fA-F]{40}$"
                }
              ]
