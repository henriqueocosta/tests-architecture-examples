            "txHash": "0xabababababababababababababababababababababababababababababababab"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.swapId": {
              "combine": "AND",
