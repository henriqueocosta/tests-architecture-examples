{
  "name": "mini-dex-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "concurrently": "10.0.5",
    "ethers": "6.17.0",
    "express": "5.2.1",
    "hardhat": "3.18.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wait-on": "9.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@pact-foundation/pact": "17.1.4",
    "@playwright/test": "1.63.0",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/supertest": "7.2.1",
    "chai": "6.2.2",
    "mocha": "12.0.2",
    "supertest": "7.3.0"
  },
  "scripts": {
    "postinstall": "hardhat build && playwright install chromium",
    "dev": "concurrently --names chain,provider,api --prefix-colors blue,magenta,green --kill-others \"npm run chain\" \"npm run provider\" \"wait-on tcp:127.0.0.1:8545 http://127.0.0.1:4001/health && npm run chain:deploy && npm run api\"",
    "chain": "hardhat node",
    "chain:deploy": "tsx scripts/deploy.ts",
    "chain:set-rate": "tsx scripts/set-rate.ts 1.5",
    "chain:restore-rate": "tsx scripts/set-rate.ts 2",
    "chain:block-time": "tsx scripts/block-time.ts",
    "provider": "tsx price-provider/server.ts",
    "provider:normal": "tsx scripts/provider-mode.ts normal",
    "provider:slow": "tsx scripts/provider-mode.ts slow",
    "provider:down": "tsx scripts/provider-mode.ts down",
    "provider:429": "tsx scripts/provider-mode.ts rate_limited",
    "provider:malformed": "tsx scripts/provider-mode.ts malformed",
    "api": "tsx api/src/server.ts",
    "indexer:pause": "tsx scripts/indexer.ts pause",
    "indexer:resume": "tsx scripts/indexer.ts resume",
    "indexer:status": "tsx scripts/indexer.ts status",
    "indexer:replay": "tsx scripts/indexer.ts replay",
    "typecheck": "tsc -p .",
    "test:api": "LOG_LEVEL=silent mocha \"tests/api/**/*.test.ts\"",
    "test:contract:consumer": "rm -rf pacts && mocha tests/contract/consumer.test.ts",
    "test:contract:provider": "LOG_LEVEL=silent mocha tests/contract/provider.test.ts",
    "test:async": "mocha tests/async/swaps.test.ts",
    "test:ui": "playwright test --config playwright.ui.config.ts",
    "test:e2e": "playwright test --config playwright.e2e.config.ts",
    "nonce:naive": "tsx scripts/nonce-strategy.ts naive",
    "nonce:managed": "tsx scripts/nonce-strategy.ts managed",
    "synthetic": "tsx synthetic/monitor.ts",
    "perf": "K6_WEB_DASHBOARD=true K6_WEB_DASHBOARD_PERIOD=1s K6_WEB_DASHBOARD_EXPORT=perf/report.html k6 run perf/swaps.js",
    "reset": "tsx scripts/reset.ts"
  }
}
